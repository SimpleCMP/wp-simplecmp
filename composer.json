{
  "name": "simplecmp/wp-simplecmp",
  "description": "SimpleCMP Consent Manager for WordPress – open-source consent banner with tracker auto-detection, service database, and CMS-bridge webhook.",
  "type": "wordpress-plugin",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Sven Wappler",
      "email": "sven@wappler.eu"
    }
  ],
  "require": {
    "php": "^8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "SimpleCMP\\WpSimpleCmp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SimpleCMP\\WpSimpleCmp\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
